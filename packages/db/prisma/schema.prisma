// EGAPS Modern — Prisma schema, Personnel (ePMIS) module scaffold.
//
// Field-level source of truth: real schema pulled directly from the live production
// databases on 2026-09-09 (see legacy_db/schema_dump*.txt), not the earlier
// code-inferred version — see docs/legacy/DATABASE_SCHEMA.md and
// docs/modernization/DATA_MIGRATION_ANALYSIS.md for full provenance and rationale.
//
// Legacy EXTENT arrays (Personal.Child-Name[15]/Child-Age[15]) are normalized into
// real relations here (Dependent), not carried forward as arrays/JSON, since they're
// genuinely relational data — DATA_MIGRATION_ANALYSIS.md §6.
//
// This is a structural scaffold only: models + a first migration. No data migration
// script, no CRUD logic yet — see the approved plan.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums — replacing legacy character-coded status fields with real types.
// Values confirmed from live production data (2026-09-09), not guessed.
// ---------------------------------------------------------------------------

// Appointment.status is a plain String, not an enum — see AppointmentStatusCode
// below (Master Data section) for the full known-code catalog. Real production
// data carries 12 codes beyond the 21 the live `appointstatus` lookup table
// itself has, which ruled out a hard enum here.

/// From Appointment.Pay-Mode: 1=Daily, 2=Weekly, 3=Semi-Monthly, 4=Monthly.
enum PayMode {
  DAILY
  WEEKLY
  SEMI_MONTHLY
  MONTHLY
}

/// From Appointment.Work-Level: 1=First Level, 2=Second Level, 3=Third Level (CSC classification).
enum WorkLevel {
  FIRST_LEVEL
  SECOND_LEVEL
  THIRD_LEVEL
}

/// Appointment.appoint-type. CONFIRMED against real production data
/// (2026-09-10, 1,188 real Appointment rows): only 3 of the 6 values below are
/// ever actually used — 1=REGULAR (914 rows — covers Permanent/Appointed/
/// Co-Terminous/Elected/Part-time/Substitute per the EmployType lookup table),
/// 2=CASUAL (227 rows), 3=CONTRACT_OF_SERVICE (47 rows — legacy lumps
/// Contractual/Job Order/Medical Contractual/Service Contract/Temporary all
/// under this one code; JOB_ORDER/CONSULTANT/SPECIAL below are never
/// distinguished at this field, kept for schema completeness only).
enum AppointType {
  REGULAR
  CASUAL
  JOB_ORDER
  CONTRACT_OF_SERVICE
  CONSULTANT
  SPECIAL
}

/// EmployeeTraining.type — CS Form 212 Section VI "Type of L&D" classification.
enum LearningDevelopmentType {
  FOUNDATION
  MANAGERIAL
  SUPERVISORY
  TECHNICAL
  CLERICAL
  OTHERS
}

// ---------------------------------------------------------------------------
// Master data
// ---------------------------------------------------------------------------

model Department {
  id              String   @id @default(cuid())
  deptCode        Int      @unique // legacy Dept-Code
  deptDesc        String
  shortDesc       String?
  deptHead        String?
  certifyName     String? // legacy Certify-Name — printed-document signatory, not a live approval gate (PAYROLL_ANALYSIS.md §11)
  certifyPosition String?
  approveName     String? // legacy Approve-Name — same caveat
  approvePosition String?
  fundCode        Int?
  subCode         String?
  refCode         String?

  divisions    Division[]
  employees    Employee[]
  appointments Appointment[]
  plantillas   Plantilla[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("departments")
}

/// AppointmentStatusCode.mode — HR-editable classification of what a status
/// code means for an employee's standing: ENTRY (joining/returning to
/// service), EXIT (leaving it, drives the Employee.inactive auto-sync), or
/// unset (a lateral change like Promotion/Salary Adjustment, affects neither).
enum AppointmentStatusMode {
  ENTRY
  EXIT
}

/// Legacy AppointStatus lookup table (Master Data > Appointment Status File).
/// Not a hard FK from Appointment.status — informational/editable labels only,
/// same as legacy itself (see Appointment.status's doc comment).
model AppointmentStatusCode {
  id          String  @id @default(cuid())
  code        String  @unique
  description String
  active      Boolean @default(true)
  mode        AppointmentStatusMode?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("appointment_status_codes")
}

/// Legacy EmployType table (emp-status/emp-desc) — the employee's tenure
/// classification (Permanent, Casual, Job Order, ...), distinct from
/// AppointmentStatusCode which tracks the *action* taken on an appointment.
model EmploymentStatusCode {
  id          String  @id @default(cuid())
  code        String  @unique
  description String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("employment_status_codes")
}

model Division {
  id           String   @id @default(cuid())
  divCode      Int      @unique
  divDesc      String
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])

  employees      Employee[]
  plantillaItems Plantilla[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("divisions")
}

model Position {
  id            String  @id @default(cuid())
  positionCode  Int     @unique // legacy Position-Code
  positionDesc  String
  shortDesc     String?
  positionGroup Int?    // legacy pGroup-Code

  appointments Appointment[]
  plantillas   Plantilla[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("positions")
}

model Plantilla {
  id     String @id @default(cuid())
  // legacy Item-No — DBM-prescribed plantilla identifier, preserved unchanged
  // (DATA_MIGRATION_ANALYSIS.md §5). NOT globally unique: legacy's own
  // indexes key it as Type+Dept-Code+Div-Code+Item-No — confirmed against
  // real data, 21 of 855 real item numbers are reused across departments
  // (e.g. "178" exists once under dept 27 and again, unrelated, under dept
  // 59). Unique per department instead, see @@unique below.
  itemNo String
  oldItemNo    String?
  pageNo       Int?
  actualSalary Decimal? @db.Decimal(14, 2)
  authSalary   Decimal? @db.Decimal(14, 2)
  grade        Int?
  step         Int?
  partTime     Boolean  @default(false)

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  positionId   String?
  position     Position?  @relation(fields: [positionId], references: [id])
  // Real data: only 59 of 855 real plantilla items carry a non-zero legacy
  // Div-Code — kept here for schema completeness but left unpopulated until
  // a real Division File/master-data import exists (no Division CRUD yet).
  divisionId   String?
  division     Division?  @relation(fields: [divisionId], references: [id])
  // The item's current incumbent — legacy plantilla.Emp-No, the real direct
  // source of "who holds this item", not derived from Appointment.itemNo.
  employeeId   String?
  employee     Employee?  @relation(fields: [employeeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([departmentId, itemNo])
  @@map("plantillas")
}

/// A named salary schedule/version — legacy sGradeType x sgrade-effectivity
/// (e.g. "2026 SSL 3rd Tranche - Main" vs. "...- Health", or an older
/// effectivity kept for employees still paid off it). Each table owns its
/// own full 1-50 grade grid; an Employee optionally points at the one that
/// applies to them (Employee.salaryGradeTableId) instead of always using
/// whatever table happens to be "current".
model SalaryGradeTable {
  id            String    @id @default(cuid())
  name          String
  effectiveDate DateTime?
  description   String?

  grades    SalaryGrade[]
  employees Employee[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("salary_grade_tables")
}

model SalaryGrade {
  id      String @id @default(cuid())
  gradeNo Int // legacy sgrade-no

  salaryGradeTableId String
  salaryGradeTable   SalaryGradeTable @relation(fields: [salaryGradeTableId], references: [id], onDelete: Cascade)

  steps SalaryStep[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([salaryGradeTableId, gradeNo])
  @@map("salary_grades")
}

/// Normalizes the legacy SGrade.amount[10]/monthly-rate[10] EXTENT arrays
/// (one entry per step 1-10) into real rows.
model SalaryStep {
  id            String  @id @default(cuid())
  salaryGradeId String
  salaryGrade   SalaryGrade @relation(fields: [salaryGradeId], references: [id], onDelete: Cascade)
  stepNo        Int // 1-10
  amount        Decimal @db.Decimal(14, 2)
  monthlyRate   Decimal @db.Decimal(14, 2)

  @@unique([salaryGradeId, stepNo])
  @@map("salary_steps")
}

// ---------------------------------------------------------------------------
// Personnel core
// ---------------------------------------------------------------------------

model Employee {
  id     String @id @default(cuid())
  empNo  Int    @unique // legacy Emp-No — preserved unchanged, the universal join key (DATA_MIGRATION_ANALYSIS.md §5)

  lastName   String
  firstName  String
  middleName String?
  suffix     String?

  birthDate  DateTime?
  birthPlace String?
  sex        String? // legacy free-text "Male"/"Female" default — revisit as enum once full value set confirmed
  civilStatus String?
  nationality String  @default("Filipino")

  fatherName       String?
  fatherBirthPlace String?
  motherName       String?
  motherBirthPlace String?
  spouseName       String?
  spouseWork       String?

  // Government-issued identifiers — never transformed, per DATA_MIGRATION_ANALYSIS.md §5
  tin           String?
  gsisNo        String?
  pagibigNo     String?
  philhealthNo  String?
  philsysNo     String? // PhilSys Card Number (PCN) — CS Form 212 item 13, not everyone has one yet

  address      String?
  telNo        String?
  cellNo       String?
  emailAddress String?
  bankAccountNo String?

  taxStatus String? // legacy Tax-Status — full BIR code table still pending, OQ-43/OQ-28

  dateHired      DateTime?
  hiredDate      DateTime? // legacy carries both Hired-Date and date-hired distinctly — kept separate pending clarification
  appointDate    DateTime?

  inactive         Boolean   @default(false)
  dateInactivated  DateTime?
  inactiveCause    String?

  // Physical/ID — legacy Personal Data Sheet fields (PERSONNEL_ANALYSIS.md, personal table)
  height       Decimal? @db.Decimal(5, 2)
  weight       Decimal? @db.Decimal(5, 2)
  bloodType    String?
  idNo         String? // legacy id-no — a separate ID-card number from empNo/biometricId
  biometricId  String? // legacy bio-id

  // Classification — free-text for now; legacy PWD/Religion/Country master tables
  // are deferred (Master Data section, not yet built) rather than a prerequisite here.
  pwdType  String?
  religion String?
  country  String?

  jobDescription String? // legacy job-desc-code lookup — free text for now, same reasoning as above
  remarks        String?

  // Present address components (legacy addr-* fields) — Province/Locality/Barangay
  // kept free-text pending the Master Data geographic reference tables.
  addrUnitNo   String?
  addrStreet   String?
  addrPhase    String?
  addrBlockNo  String?
  addrLot      String?
  addrBarangay String?
  addrLocality String?
  addrProvince String?
  addrZip      String?
  addrTelNo    String?

  // Permanent address — legacy shows this as a read-only summary box, not a second
  // full structured-component set, so kept as free text.
  permanentAddress  String?
  permanentTelNo    String?
  permanentZipCode  String?

  // HR sign-off on the PDS record itself (legacy Validated/Validated-by/Validate-Date).
  validated     Boolean   @default(false)
  validatedDate DateTime?
  validatedBy   String?

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  divisionId   String?
  division     Division?   @relation(fields: [divisionId], references: [id])

  // Which salary schedule this employee is paid off — optional; unset means
  // "use whatever table the payroll process treats as current."
  salaryGradeTableId String?
  salaryGradeTable   SalaryGradeTable? @relation(fields: [salaryGradeTableId], references: [id], onDelete: SetNull)

  dependents     Dependent[]
  appointments   Appointment[]
  changeLogs     AppointmentChangeLog[]
  serviceRecords ServiceRecord[]
  educationRecords     EmployeeEducation[]
  eligibilityRecords   EmployeeEligibility[]
  workExperience       EmployeeWorkExperience[]
  trainingRecords      EmployeeTraining[]
  skills               EmployeeSkill[]
  voluntaryWork        EmployeeVoluntaryWork[]
  distinctions         EmployeeDistinction[]
  orgMemberships       EmployeeOrgMembership[]
  plantillaItems       Plantilla[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("employees")
}

/// Educational Background File — legacy `Educations` table (confirmed the real
/// one-row-per-entry backing store via its Emp-No+Level+School-Name+School-Year
/// unique index, not the EXTENT=8 arrays duplicated on `personal`).
model EmployeeEducation {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  level      String
  schoolName String
  // Replaces the old single `schoolYear` free-text field (legacy stored it as
  // an unseparated "20002006"-style concatenation) — split into real years,
  // plus a year-graduated field the old column never captured at all.
  attendanceFrom Int?
  attendanceTo   Int?
  yearGraduated  Int?
  course     String?
  degree     String?
  honors     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("employee_education")
}

/// Eligibility Records File — legacy `Eligibility` table.
model EmployeeEligibility {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  examName  String
  examDate  DateTime?
  examPlace String?
  rating    String?
  licenseNumber   String?
  licenseValidity DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("employee_eligibility")
}

/// Work Experience Records File — legacy `Services` table (prior/external
/// employment history, distinct from this LGU's own Appointment history).
model EmployeeWorkExperience {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  company          String
  position         String?
  startDate        DateTime?
  endDate          DateTime?
  salary           Decimal? @db.Decimal(14, 2)
  salaryUnit       String?
  employmentStatus String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("employee_work_experience")
}

/// Training/Study/Seminar Records File — legacy `Training` table.
model EmployeeTraining {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  trainingName   String
  startDate      DateTime?
  endDate        DateTime?
  conductor      String?
  periodCovered  String?
  numberOfHours  Int?
  type           LearningDevelopmentType?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("employee_training")
}

/// Employee Skills — legacy Personal.Skills free-text field, normalized to a
/// simple add/remove list matching the Dependent model's existing pattern.
model EmployeeSkill {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  name       String

  createdAt DateTime @default(now())

  @@map("employee_skills")
}

/// CS Form 212 Section VII — Voluntary Work / civic involvement. No legacy
/// backing table; new for the PDS generation feature.
model EmployeeVoluntaryWork {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  organization  String
  address       String?
  startDate     DateTime?
  endDate       DateTime?
  numberOfHours Int?
  position      String? // Position/Nature of Work

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("employee_voluntary_work")
}

/// CS Form 212 Section VIII item 32 — Non-Academic Distinctions/Recognition.
/// Simple add/remove list, same shape as EmployeeSkill.
model EmployeeDistinction {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  name       String

  createdAt DateTime @default(now())

  @@map("employee_distinctions")
}

/// CS Form 212 Section VIII item 33 — Membership in Association/Organization.
/// Simple add/remove list, same shape as EmployeeSkill.
model EmployeeOrgMembership {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  name       String

  createdAt DateTime @default(now())

  @@map("employee_org_memberships")
}

/// Normalizes legacy Personal.Child-Name[15]/Child-Age[15] EXTENT arrays into
/// real relational rows — DATA_MIGRATION_ANALYSIS.md §6.
model Dependent {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  name       String
  birthDate  DateTime?
  age        Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("dependents")
}

/// Appointment — the effective-dated "current state" layer of the confirmed
/// three-layer personnel history model (PERSONNEL_ANALYSIS.md §2, §6).
/// Deliberately NOT unique per employee — the legacy schema allows (and the
/// live analysis confirmed, in a small number of cases) more than one row per
/// employee; resolution rule for that edge case is a migration-time decision
/// (OQ-42), not a schema-level constraint here.
model Appointment {
  id String @id @default(cuid())

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  positionId   String?
  position     Position?   @relation(fields: [positionId], references: [id])

  itemNo String? // legacy Item-No — plantilla item, preserved unchanged

  // Plain string, not the AppointmentStatus enum — real production data (see
  // AppointmentStatusCode below) carries 12 codes that exist in neither the
  // enum nor even the legacy AppointStatus lookup table itself. Legacy itself
  // has no enforced FK from Appointment.Status-Code to AppointStatus, which is
  // exactly how those orphaned codes exist in the first place.
  // employmentStatus is a plain String, not an enum — real production data
  // (2026-09-11) confirms it's a raw EmployType.emp-status code (P/CS/CL/CT/EL,
  // see Master Data > Employment Status File / EmploymentStatusCode), not the
  // 1-6 numeric scheme PERSONNEL_ANALYSIS.md guessed at before real DB access.
  status           String?
  employmentStatus String?
  appointType      AppointType?
  payMode          PayMode?
  workLevel        WorkLevel?

  authSalary  Decimal? @db.Decimal(14, 2)
  actualSalary Decimal? @db.Decimal(14, 2)
  monthlyRate Decimal? @db.Decimal(14, 2)

  effectDate DateTime?
  startDate  DateTime?
  endDate    DateTime?
  exitDate   DateTime?
  exitCause  String?

  stepNo Int?
  grade  Int?
  rank   Int?

  taxStatus String?
  withTax   Decimal? @db.Decimal(14, 2)

  repAllowance     Decimal? @db.Decimal(14, 2)
  travelAllowance  Decimal? @db.Decimal(14, 2)
  subsAllowance    Decimal? @db.Decimal(14, 2)
  laundryAllowance Decimal? @db.Decimal(14, 2)
  quarterAllowance Decimal? @db.Decimal(14, 2)

  pagibigRate Decimal? @db.Decimal(14, 2)
  coopRate    Decimal? @db.Decimal(14, 2)

  // Legacy "without X deduction" exemption flags — confirmed real fields,
  // BUSINESS_RULES.md BR-001/BR-004 consume these during payroll calculation.
  woGsis       Boolean @default(false)
  woPagibig    Boolean @default(false)
  woPhilhealth Boolean @default(false)
  woWtax       Boolean @default(false)
  woPera       Boolean @default(false)
  woCaa        Boolean @default(false)
  woCoop       Boolean @default(false)
  woSif        Boolean @default(false)
  exemptPagibig Boolean @default(false)

  withRata  Boolean @default(false)
  vouchered Boolean @default(false)
  partTime  Boolean @default(false)
  partTimePercent Decimal? @db.Decimal(5, 2)

  vlBalance Decimal? @db.Decimal(10, 2)
  slBalance Decimal? @db.Decimal(10, 3)

  /// Legacy sMode: 1=active, 2=inactive — CONFIRMED derived from which
  /// AppointmentStatus is set (PERSONNEL_ANALYSIS.md §5, real appointstatus
  /// query 2026-09-09), not independently maintained. Kept here for direct
  /// migration fidelity; application logic should derive it, not set it directly.
  sMode Int?

  groupNo      Int?
  assignCode   Int?
  localityCode Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId, effectDate])
  @@index([departmentId, itemNo])
  @@map("appointments")
}

/// The confirmed append-only audit-trail layer — full before/after snapshot
/// per appointment change, including a performance rating at time of change.
/// PERSONNEL_ANALYSIS.md §2; CHGAPP.P lines 79-164.
model AppointmentChangeLog {
  id String @id @default(cuid())

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  year       Int
  effectDate DateTime

  // "Old" snapshot — captured before the change was applied.
  oldDeptCode     Int?
  oldPositionCode Int?
  oldActlSalary   Decimal? @db.Decimal(14, 2)
  oldMonthlyRate  Decimal? @db.Decimal(14, 2)
  oldItemNo       String?
  oldStatusCode   String?
  oldEmpStatus    String?
  oldGrade        Int?
  oldStep         Int?

  // "New" values as of this change.
  deptCode     Int?
  positionCode Int?
  actlSalary   Decimal? @db.Decimal(14, 2)
  monthlyRate  Decimal? @db.Decimal(14, 2)
  itemNo       String?
  statusCode   String?
  empStatus    String?
  grade        Int?
  step         Int?

  /// Legacy Efficient-Rate: 1=Excellent .. 5=Unsatisfactory (CHGAPP.P line 48-51).
  efficiencyRate Int?

  /// Who recorded this change — the legacy system had no equivalent (it only
  /// captured a printed-document signatory, PAYROLL_ANALYSIS.md §11), this is
  /// a deliberate improvement now that real auth exists.
  changedByUserId String?
  changedByUser   User?   @relation(fields: [changedByUserId], references: [id])

  createdAt DateTime @default(now())

  @@index([employeeId, year, effectDate])
  @@map("appointment_change_logs")
}

/// The confirmed chained, gapless service-history layer.
/// PERSONNEL_ANALYSIS.md §2, §6; legacy ServiceRecord table.
model ServiceRecord {
  id String @id @default(cuid())

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  startDate DateTime
  endDate   DateTime?

  // Legacy stores these as denormalized text snapshots at time of record,
  // not live FKs — preserved as-is since it's historical record, not current state.
  positionSnapshot   String?
  departmentSnapshot String?
  divisionSnapshot   String?
  empStatusSnapshot  String?
  salarySnapshot     Decimal? @db.Decimal(14, 2)
  salaryUnitSnapshot String?
  // Annual salary — the Service Record certificate (CSC form) always shows
  // salary "/a" (per annum), distinct from salarySnapshot/salaryUnitSnapshot
  // above which is monthly (used elsewhere in the app).
  actlSalarySnapshot Decimal? @db.Decimal(14, 2)
  grade              Int?
  step               Int?
  itemNo             String?

  exitDate  DateTime?
  exitCause String?

  leaveAbsence String?
  remarks      String?
  signatory       String?
  signPosition    String?

  createdAt DateTime @default(now())

  @@index([employeeId, startDate])
  @@map("service_records")
}

// ---------------------------------------------------------------------------
// Cross-cutting: RBAC and audit (FR-026 / FR-027)
// Modeled fresh per MODERNIZATION_BOUNDARY.md — the legacy module+action-level
// permission concept is worth preserving, the exact au-chkaccess.p DB-driven
// mechanism is not replicated 1:1.
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  loginId      String   @unique
  passwordHash String
  fullName     String
  active       Boolean  @default(true)

  employeeId String? @unique
  // Optional link to an Employee record — not every system user is necessarily
  // an employee row (e.g. a superadmin account), so this stays nullable.

  roles     UserRole[]
  auditLogs AuditLog[]
  appointmentChanges AppointmentChangeLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?

  users       UserRole[]
  permissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("roles")
}

model Permission {
  id     String @id @default(cuid())
  module String // e.g. "personnel", "attendance", "payroll"
  action String // e.g. "view", "create", "edit", "delete", "approve"

  roles RolePermission[]

  @@unique([module, action])
  @@map("permissions")
}

model UserRole {
  userId String
  user   User   @relation(fields: [userId], references: [id])
  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id])
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// Replicates the legacy Audit-Hdr concept: who/when/where/module/action/outcome
/// (SECURITY_ANALYSIS.md §6) — a genuinely strong existing capability worth
/// preserving, not a legacy weakness.
model AuditLog {
  id String @id @default(cuid())

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  module      String
  action      String
  description String
  outcome     String // e.g. "success", "denied"
  ipAddress   String?

  createdAt DateTime @default(now())

  @@index([module, createdAt])
  @@index([userId, createdAt])
  @@map("audit_logs")
}
